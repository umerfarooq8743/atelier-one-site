# Atelier One marketing site — copy to .env.local (or set in Vercel → Project → Settings → Environment Variables)

# Public URL of this website, used for canonical URLs, sitemap and Open Graph.
# On Vercel production this falls back to VERCEL_PROJECT_PRODUCTION_URL automatically.
NEXT_PUBLIC_SITE_URL=

# WhatsApp number for inquiries, international format, digits only (e.g. 923001234567).
# Leave empty and the form will say WhatsApp isn't configured instead of pretending to send.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Public contact email and phone shown on the contact page and footer. Leave empty to hide.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# Optional business location. Only set this when it is genuine.
NEXT_PUBLIC_BUSINESS_LOCATION=
